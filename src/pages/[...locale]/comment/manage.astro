---
export const prerender = false;

import config from "$config";
import { Token } from "$lib/token";
import Base from "$layouts/Base.astro";
import Manager from "$components/comment/Manager.svelte";
import i18nit from "$i18n";

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

const passport = await Token.check(Astro.cookies, "passport", false);
const authorId = Astro.locals.runtime.env.AUTHOR_ID ?? null;
const authorized = Boolean(authorId && passport?.visa === authorId);
---

<Base title={t("comment.manage.title")} {locale}>
	<main class="flex flex-col gap-6 grow">
		{
			authorized ? (
				<Manager client:load {locale} />
			) : (
				<section class="py-[18vh] text-center flex flex-col gap-3">
					<h2>{t("comment.manage.title")}</h2>
					<p class="text-secondary">{t("comment.manage.unauthorized")}</p>
				</section>
			)
		}
	</main>
</Base>
