---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config, { monolocale } from "$config";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import TOC from "$components/TOC.astro";
import Comments from "$components/comment/Section.astro";
import Position from "$components/Position.astro";
import Icon from "$components/Icon.svelte";
import Sensitive from "$components/Sensitive.svelte";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Get all notes excluding drafts
	const notes = await getCollection("note", note => !note.data.draft);

	return notes.map(note => {
		let locale: string | undefined;
		let id: string;

		if (monolocale) {
			locale = undefined;
			id = note.id;
		} else {
			// Extract language and note ID from file path structure
			const [language, ...ids] = note.id.split("/");

			locale = config.i18n.defaultLocale === language ? undefined : language;
			id = ids.join("/");
		}

		// Generate path params with optional locale (omit for default locale)
		return { params: { locale, id }, props: { note } };
	});
}

const { locale = config.i18n.defaultLocale } = Astro.params;
const { note } = Astro.props;

// Render markdown content and extract headings for TOC
const { Content, headings, remarkPluginFrontmatter: frontmatter } = await render(note);
const outline = headings.length ? headings : undefined;
const hasAside = !!outline || !!note.data.series;

const notes = (await getCollection("note", item => !item.data.draft && (monolocale || item.id.startsWith(`${locale}/`)))).sort(
	(a, b) => a.data.timestamp.getTime() - b.data.timestamp.getTime()
);
const current = notes.findIndex(item => item.id === note.id);
const adjacentNotes = {
	previous: current > 0 ? notes[current - 1] : undefined,
	next: current >= 0 && current < notes.length - 1 ? notes[current + 1] : undefined
};
const noteUrl = (id: string) => getRelativeLocaleUrl(locale, `/note/${monolocale ? id : id.split("/").slice(1).join("/")}`);

const series = note.data.series
	? (
			await getCollection(
				"note",
				item => !item.data.draft && item.data.series === note.data.series && (monolocale || item.id.startsWith(`${locale}/`))
			)
		)
			.sort((a, b) => a.data.timestamp.getTime() - b.data.timestamp.getTime())
			.map(item => ({
				title: item.data.title,
				url: getRelativeLocaleUrl(locale, `/note/${monolocale ? item.id : item.id.split("/").slice(1).join("/")}`),
				current: item.id === note.id
			}))
	: undefined;

const t = i18nit(locale);
---

<Base title={note.data.title} {locale} description={note.data.description} article={{ timestamp: note.data.timestamp, section: note.data.series, tags: note.data.tags }}>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{note.data.title}</h1>
			<div class="flex flex-col gap-3 sm:flex-row *:flex *:items-center *:gap-1 *:text-[0.875rem] *:text-secondary">
				<time datetime={note.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(note.data.timestamp)}</time>
				{
					note.data.series && (
						<span>
							<Icon name="lucide--layers" />
							{note.data.series}
						</span>
					)
				}
				{
					!!note.data.tags?.length && (
						<span>
							<Icon name="lucide--hash" />
							{note.data.tags?.join("; ")}
						</span>
					)
				}
				<span><Icon name="lucide--pilcrow" />{t("read.words", { count: frontmatter.words })}</span>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<Sensitive {locale} back={getRelativeLocaleUrl(locale, "/note")} sensitive={note.data.sensitive} client:load>
			<div class="contents">
				<div class="flex gap-5">
					<section id="markdown-content" class="markdown"><Content /></section>
					{(outline || !!note.data.series) && <TOC headings={outline} {locale} {series} />}
				</div>

				<nav aria-label="Adjacent notes" class:list={["mt-8 grid gap-3 sm:grid-cols-2", hasAside && "sm:me-[13.75rem]"]}>
					{
						adjacentNotes.previous ? (
							<a href={noteUrl(adjacentNotes.previous.id)} class="group flex flex-col gap-1 border-s-2 border-weak ps-3">
								<span class="inline-flex items-center gap-1 text-sm text-secondary">
									<Icon name="lucide--arrow-left" size={15} class="rtl:-scale-x-100" />
									{t("note.previous")}
								</span>
								<strong class="link text-base">{adjacentNotes.previous.data.title}</strong>
							</a>
						) : (
							<span aria-hidden="true" class="hidden sm:block" />
						)
					}
					{
						adjacentNotes.next && (
							<a href={noteUrl(adjacentNotes.next.id)} class="group flex flex-col gap-1 border-e-2 border-weak pe-3 text-end">
								<span class="inline-flex items-center justify-end gap-1 text-sm text-secondary">
									{t("note.next")}
									<Icon name="lucide--arrow-right" size={15} class="rtl:-scale-x-100" />
								</span>
								<strong class="link text-base">{adjacentNotes.next.data.title}</strong>
							</a>
						)
					}
				</nav>

				<hr class:list={["my-2 border-b border-weak", hasAside && "sm:me-[13.75rem]"]} />

				<blockquote id="comment-section" class:list={[hasAside && "sm:me-[13.75rem]"]}><Comments {locale} link={`${Astro.url.origin}${Astro.url.pathname}`} section="note" item={note.id} /></blockquote>
			</div>
		</Sensitive>

		<Position {locale} toc={!!outline} series={!!note.data.series} />
	</main>
</Base>
