---
export const prerender = false;

import config from "$config";
import Base from "$layouts/Base.astro";

const firstPathPart = Astro.url.pathname.split("/").filter(Boolean)[0];
const pageLocale = config.i18n.locales.includes(firstPathPart as any) ? firstPathPart : config.i18n.defaultLocale;
const homeHref = pageLocale === config.i18n.defaultLocale ? "/" : `/${pageLocale}`;
---

<Base title="后台管理" locale={pageLocale}>
	<main class="admin-shell">
		<header class="admin-top">
			<div>
				<p class="eyebrow">Thought Admin</p>
				<h1>后台管理</h1>
			</div>
			<div class="admin-actions">
				<button data-action="reload" class="button">刷新</button>
				<a href={homeHref} class="button ghost">返回网站</a>
			</div>
		</header>

		<section class="stats" id="stats"></section>

		<div class="workspace">
			<nav class="tabs" aria-label="后台模块">
				<button class="tab active" data-tab="content">内容</button>
				<button class="tab" data-tab="preface">序文</button>
				<button class="tab" data-tab="memos">Memos</button>
				<button class="tab" data-tab="links">友链</button>
				<button class="tab" data-tab="feeds">订阅</button>
				<button class="tab" data-tab="deploy">部署</button>
			</nav>

			<section class="panel active" data-panel="content">
				<div class="panel-head">
					<div class="panel-title">
						<h2>文章管理</h2>
						<p>文记、指南、随笔统一管理，支持目录、分类、标签和新建草稿。</p>
						<div class="panel-actions">
							<div class="filters">
								<select id="sectionFilter">
									<option value="">全部栏目</option>
									<option value="note">文记</option>
									<option value="guide">指南</option>
									<option value="jotting">随笔</option>
								</select>
								<input id="articleSearch" type="search" placeholder="搜索标题、标签、分类" />
							</div>
							<button type="button" class="button" data-action="newArticle">新建文章</button>
						</div>
					</div>
				</div>

				<div class="content-layout" id="articleWorkspace">
					<div class="article-list-page">
						<div class="table-wrap">
							<table>
								<thead>
									<tr>
										<th>标题</th>
										<th>分类</th>
										<th>标签</th>
										<th>操作</th>
									</tr>
								</thead>
								<tbody id="articleRows"></tbody>
							</table>
						</div>
					</div>

					<form id="articleForm" class="editor article-editor article-editor-page">
						<div class="editor-head">
							<h3 id="articleEditorTitle">新建文章</h3>
							<button type="button" class="button ghost" data-action="cancelArticle">返回列表</button>
						</div>
						<input type="hidden" name="originalPath" />
						<label>栏目<select name="section"><option value="note">文记</option><option value="guide">指南</option><option value="jotting">随笔</option></select></label>
						<label>语言<select name="locale"><option value="zh-cn">zh-cn</option><option value="en">en</option></select></label>
						<label>标题<input name="title" required placeholder="输入标题后自动生成 slug" /></label>
						<label>Slug<input name="slug" placeholder="auto-generated-slug" /></label>
						<label>分类<input name="series" list="seriesList" placeholder="例如：技术" /></label>
						<label>标签<input name="tags" list="tagList" placeholder="逗号或空格分隔" /></label>
						<label>摘要<textarea name="description" rows="3" placeholder="可自动提取"></textarea></label>
						<label class="check"><input type="checkbox" name="toc" /> 显示目录</label>
						<label class="check"><input type="checkbox" name="draft" /> 存为草稿</label>
						<label>正文<textarea name="body" rows="13" placeholder="Markdown 正文"></textarea></label>
						<div class="row-actions">
							<button type="button" class="button ghost" data-action="extract">提取摘要和标签</button>
							<button type="submit" class="button" data-article-submit>保存文章</button>
						</div>
						<article class="preview markdown" id="articlePreview"></article>
					</form>
				</div>
			</section>

			<section class="panel" data-panel="preface">
				<div class="panel-head">
					<div class="panel-title">
						<h2>序文</h2>
						<p>管理当前语言的本地序文，可新建、编辑和调整发布状态。</p>
						<div class="panel-actions">
							<button type="button" class="button" data-action="newPreface">新建序文</button>
						</div>
					</div>
				</div>
				<div class="content-layout" id="prefaceWorkspace">
					<div class="table-wrap">
						<table>
							<thead>
								<tr>
									<th>发布时间</th>
									<th>内容</th>
									<th>操作</th>
								</tr>
							</thead>
							<tbody id="prefaceRows"></tbody>
						</table>
					</div>
					<form id="prefaceForm" class="editor preface-editor">
						<div class="editor-head">
							<h3 id="prefaceEditorTitle">新建序文</h3>
							<button type="button" class="button ghost" data-action="cancelPreface">收起</button>
						</div>
						<input type="hidden" name="originalPath" />
						<label>语言<select name="locale"><option value="zh-cn">zh-cn</option><option value="en">en</option></select></label>
						<label>时间<input name="timestamp" type="datetime-local" /></label>
						<label>内容<textarea name="body" rows="12" placeholder="写一段序文或动态"></textarea></label>
						<label class="check"><input type="checkbox" name="draft" /> 存为草稿</label>
						<button type="submit" class="button" data-preface-submit>保存序文</button>
					</form>
				</div>
			</section>

			<section class="panel" data-panel="memos">
				<div class="panel-head">
					<div class="panel-title">
						<h2>Memos</h2>
						<p>只显示当前语言的 Memos API 内容。</p>
					</div>
				</div>

				<form id="memoForm" class="editor memo-editor">
					<label>发布内容<textarea name="content" rows="5" placeholder="写一条新的 Memos"></textarea></label>
					<div class="row-actions">
						<button type="submit" class="button" data-memo-submit>发布 Memos</button>
					</div>
				</form>

				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>发布时间</th>
								<th>内容</th>
							</tr>
						</thead>
						<tbody id="memosRows"></tbody>
					</table>
				</div>
			</section>

			<section class="panel" data-panel="links">
				<div class="panel-head">
					<div class="panel-title">
						<h2>友链</h2>
						<p>管理网站连结，添加时可输入域名自动发现名称、头像和订阅地址。</p>
						<div class="panel-actions">
							<button type="button" class="button ghost" data-action="checkLinks">检测友链</button>
							<button type="button" class="button" data-action="addLink">添加友链</button>
						</div>
					</div>
				</div>

				<div class="link-layout" id="linkWorkspace">
					<div class="link-list-page">
						<div id="linksList" class="link-grid"></div>
					</div>
					<div class="link-add-page">
						<div class="editor-head">
							<div>
								<h3>添加友链</h3>
								<p>输入域名后可自动发现网站名称、头像和订阅地址。</p>
							</div>
							<button type="button" class="button ghost" data-action="cancelLink">返回列表</button>
						</div>
						<form id="discoverForm" class="discover">
							<input name="url" placeholder="example.com 或 https://example.com" />
							<button class="button" type="submit">发现</button>
						</form>
						<form id="linkForm" class="editor compact">
							<input type="hidden" name="originalUrl" />
							<label>名称<input name="title" /></label>
							<label>网址<input name="url" /></label>
							<label>类型<input name="type" placeholder="lifestyle / technology / creative" /></label>
							<label>头像<input name="image" /></label>
							<label>订阅<input name="feed" /></label>
							<label>描述<textarea name="description" rows="3"></textarea></label>
							<button class="button" type="submit">保存友链</button>
						</form>
					</div>
				</div>
			</section>

			<section class="panel" data-panel="feeds">
				<div class="panel-head">
					<div class="panel-title">
						<h2>订阅</h2>
						<p>只显示友链订阅源和订阅 API 刷新的文章更新。</p>
						<div class="panel-actions">
							<button type="button" class="button" data-action="refreshFeeds">刷新订阅</button>
						</div>
					</div>
				</div>

				<div id="feedsList" class="feed-list"></div>
			</section>

			<section class="panel" data-panel="deploy">
				<div class="panel-head">
					<div>
						<h2>提交与部署</h2>
						<p>本地 Git 仓库状态、提交、推送并部署到 Cloudflare。</p>
					</div>
				</div>
				<form id="deployForm" class="deploy-box">
					<label>提交信息<input name="message" value="Update content from admin" /></label>
					<div class="row-actions">
						<button type="button" class="button ghost" data-deploy="status">状态</button>
						<button type="button" class="button ghost" data-deploy="commit">提交</button>
						<button type="button" class="button ghost" data-deploy="push">推送</button>
						<button type="button" class="button ghost" data-deploy="deploy">部署</button>
						<button type="button" class="button" data-deploy="all">一键提交推送部署</button>
					</div>
				</form>
				<pre id="deployOutput" class="log"></pre>
			</section>
		</div>

		<datalist id="tagList"></datalist>
		<datalist id="seriesList"></datalist>
		<div id="toast" class="toast" hidden></div>
	</main>
</Base>

<script>
	// @ts-nocheck
	const state = {
		articles: [],
		prefaces: [],
		links: [],
		chronicle: [],
		feeds: [],
		feedSources: [],
		tags: [],
		series: [],
		counts: {},
		currentLocale: currentLocaleFromPath()
	};

	const $ = selector => document.querySelector(selector);
	const $$ = selector => Array.from(document.querySelectorAll(selector));
	const field = (form, name) => form.elements.namedItem(name);

	function currentLocaleFromPath() {
		const first = location.pathname.split("/").filter(Boolean)[0];
		return first === "en" ? "en" : "zh-cn";
	}

	function toast(message) {
		const node = $("#toast");
		node.textContent = message;
		node.hidden = false;
		clearTimeout(toast.timer);
		toast.timer = setTimeout(() => (node.hidden = true), 2600);
	}

	async function api(action, body = undefined) {
		const response = await fetch(`/api/admin/${action}`, {
			method: body ? "POST" : "GET",
			headers: body ? { "content-type": "application/json" } : undefined,
			body: body ? JSON.stringify(body) : undefined
		});
		const data = await response.json();
		if (!data.ok) throw new Error(data.error || "操作失败");
		return data;
	}

	function escapeHTML(value = "") {
		return String(value).replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char]);
	}

	function slugify(value) {
		return value
			.trim()
			.toLowerCase()
			.replace(/[^\p{L}\p{N}\s_-]+/gu, "")
			.replace(/[\s_]+/g, "-")
			.replace(/-+/g, "-")
			.replace(/^-|-$/g, "");
	}

	function stripMarkdown(value) {
		return value
			.replace(/```[\s\S]*?```/g, " ")
			.replace(/!\[[^\]]*]\([^)]*\)/g, " ")
			.replace(/\[([^\]]+)]\([^)]*\)/g, "$1")
			.replace(/[#>*_`~\\-|]/g, " ")
			.replace(/<[^>]+>/g, " ")
			.replace(/\s+/g, " ")
			.trim();
	}

	function extractTags(value) {
		return Array.from(new Set(stripMarkdown(value).match(/[A-Za-z][A-Za-z0-9+#.-]{1,24}|[\u4e00-\u9fa5]{2,6}/g) || [])).slice(0, 8);
	}

	function markdown(value) {
		return escapeHTML(value)
			.replace(/^### (.+)$/gm, "<h3>$1</h3>")
			.replace(/^## (.+)$/gm, "<h2>$1</h2>")
			.replace(/^# (.+)$/gm, "<h1>$1</h1>")
			.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
			.replace(/`(.+?)`/g, "<code>$1</code>")
			.replace(/\n{2,}/g, "</p><p>")
			.replace(/^(.+)$/s, "<p>$1</p>");
	}

	function openArticleEditor(mode = "new") {
		$("#articleEditorTitle").textContent = mode === "edit" ? "编辑文章" : "新建文章";
		$("[data-article-submit]").textContent = mode === "edit" ? "保存修改" : "保存文章";
		$("#articleWorkspace").classList.add("editing");
	}

	function openPrefaceEditor(mode = "new") {
		$("#prefaceEditorTitle").textContent = mode === "edit" ? "编辑序文" : "新建序文";
		$("[data-preface-submit]").textContent = mode === "edit" ? "保存修改" : "保存序文";
		$("#prefaceWorkspace").classList.add("editing");
	}

	function tagList(tags) {
		return Array.isArray(tags) ? tags : String(tags || "").split(/[,，、\s]+/).filter(Boolean);
	}

	function dateOnly(value) {
		const raw = String(value || "").trim();
		if (!raw || raw === "undefined" || raw === "null") return "";
		const match = raw.match(/\d{4}-\d{2}-\d{2}/);
		return match ? match[0] : raw;
	}

	function datetimeLocal(value) {
		const raw = String(value || "").trim();
		const match = raw.match(/(\d{4}-\d{2}-\d{2})[T\s](\d{2}:\d{2})/);
		return match ? `${match[1]}T${match[2]}` : "";
	}

	function linkStatus(item) {
		if (item.status === undefined || item.status === null || item.status === "") return { text: "未检测", ok: false, pending: true };
		const status = Number(item.status);
		if (Number.isFinite(status)) return { text: status >= 200 && status < 400 ? `正常 ${status}` : `异常 ${status}`, ok: status >= 200 && status < 400 };
		return { text: String(item.status), ok: false };
	}

	function normalizeLocale(value) {
		const raw = String(value || "").toLowerCase().replace("_", "-");
		if (raw.startsWith("zh")) return "zh-cn";
		if (raw.startsWith("en")) return "en";
		return "";
	}

	function inferTextLocale(value) {
		return /[\u3400-\u9fff]/.test(String(value || "")) ? "zh-cn" : "en";
	}

	function itemLocale(item) {
		return normalizeLocale(item?.locale || item?.lang || item?.language);
	}

	function localizedArticles() {
		return state.articles.filter(item => itemLocale(item) === state.currentLocale);
	}

	function localizedPrefaces() {
		return state.prefaces.filter(item => itemLocale(item) === state.currentLocale);
	}

	function localizedMemos() {
		return state.chronicle.filter(item => {
			const locale = itemLocale(item);
			if (locale) return locale === state.currentLocale;
			return inferTextLocale(item.text || item.title || "") === state.currentLocale;
		});
	}

	function localizedTags() {
		return [...new Set(localizedArticles().flatMap(item => tagList(item.tags)))].sort();
	}

	function localizedSeries() {
		return [...new Set(localizedArticles().map(item => item.series).filter(Boolean))].sort();
	}

	function renderStats() {
		$("#stats").innerHTML = [
			["文章", localizedArticles().length],
			["序文", localizedPrefaces().length],
			["Memos", localizedMemos().length],
			["友链", state.counts.links || 0],
			["标签", localizedTags().length],
			["分类", localizedSeries().length]
		]
			.map(([label, value]) => `<div><span>${label}</span><strong>${value}</strong></div>`)
			.join("");
	}

	function renderArticles() {
		const keyword = $("#articleSearch").value.trim().toLowerCase();
		const section = $("#sectionFilter").value;
		const rows = localizedArticles().filter(item => {
			const haystack = `${item.title} ${item.series} ${(item.tags || []).join(" ")}`.toLowerCase();
			return (!section || item.section === section) && (!keyword || haystack.includes(keyword));
		});
		$("#articleRows").innerHTML =
			rows
				.slice(0, 120)
				.map(
					item => `<tr class="article-row">
					<td>
						<a class="article-title-link" href="${escapeHTML(item.url || `/${item.section}/${item.slug}`)}" target="_blank">${escapeHTML(item.title)}</a>
						${item.draft ? `<span class="draft-badge">草稿</span>` : ""}
					</td>
					<td>${escapeHTML(item.series || "-")}</td>
					<td>${tagList(item.tags).map(tag => escapeHTML(tag)).join("、") || "-"}</td>
					<td>
						<div class="item-actions">
							<button type="button" class="button ghost mini" data-article-action="edit" data-path="${escapeHTML(item.path)}">编辑</button>
							<button type="button" class="button ghost mini danger" data-article-action="delete" data-path="${escapeHTML(item.path)}">删除</button>
							<button type="button" class="button ghost mini" data-article-action="draft" data-path="${escapeHTML(item.path)}">草稿</button>
							<button type="button" class="button ghost mini" data-article-action="publish" data-path="${escapeHTML(item.path)}">发布</button>
						</div>
					</td>
				</tr>`
				)
				.join("") || `<tr><td colspan="4">没有匹配内容</td></tr>`;
	}

	function renderPrefaces() {
		const rows = localizedPrefaces();
		$("#prefaceRows").innerHTML =
			rows
				.sort((a, b) => String(b.timestamp || b.date || "").localeCompare(String(a.timestamp || a.date || "")))
				.slice(0, 120)
				.map(item => {
					const actions = `<div class="item-actions">
							<button type="button" class="button ghost mini" data-preface-action="edit" data-path="${escapeHTML(item.path)}">编辑</button>
							<button type="button" class="button ghost mini danger" data-preface-action="delete" data-path="${escapeHTML(item.path)}">删除</button>
							<button type="button" class="button ghost mini" data-preface-action="draft" data-path="${escapeHTML(item.path)}">草稿</button>
							<button type="button" class="button ghost mini" data-preface-action="publish" data-path="${escapeHTML(item.path)}">发布</button>
						</div>`;
					return `<tr class="preface-row">
						<td>${escapeHTML(dateOnly(item.timestamp || item.date))}</td>
						<td>
							${item.draft ? `<span class="draft-badge">草稿</span>` : ""}
							${escapeHTML(item.text || "")}
						</td>
						<td>${actions}</td>
					</tr>`;
				})
				.join("") || `<tr><td colspan="3">暂无序文</td></tr>`;
	}

	function renderMemos() {
		const rows = localizedMemos();
		$("#memosRows").innerHTML =
			rows
				.sort((a, b) => String(b.timestamp || b.date || "").localeCompare(String(a.timestamp || a.date || "")))
				.slice(0, 120)
				.map(item => `<tr class="preface-row">
					<td>${escapeHTML(dateOnly(item.timestamp || item.date))}</td>
					<td>${escapeHTML(item.text || item.title || "")}</td>
				</tr>`)
				.join("") || `<tr><td colspan="2">暂无 Memos</td></tr>`;
	}

	function renderLists() {
		$("#tagList").innerHTML = localizedTags().map(tag => `<option value="${escapeHTML(tag)}"></option>`).join("");
		$("#seriesList").innerHTML = localizedSeries().map(series => `<option value="${escapeHTML(series)}"></option>`).join("");
		renderPrefaces();
		renderMemos();
		$("#linksList").innerHTML =
			state.links
				.map(item => {
					const status = linkStatus(item);
					return `<article class="link-card">
						<img src="${escapeHTML(item.image || "/favicon.ico")}" alt="">
						<div class="link-card-body">
							<a class="link-card-title" href="${escapeHTML(item.url || "#")}" target="_blank">${escapeHTML(item.title || item.url || "未命名")}</a>
							<p>${escapeHTML(item.description || item.type || "")}</p>
							<span class="link-status ${status.ok ? "ok" : ""} ${status.pending ? "pending" : ""}">${escapeHTML(status.text)}</span>
						</div>
						<div class="item-actions link-actions">
							<button type="button" class="button ghost mini" data-link-action="edit" data-url="${escapeHTML(item.url)}">编辑</button>
							<button type="button" class="button ghost mini danger" data-link-action="delete" data-url="${escapeHTML(item.url)}">删除</button>
						</div>
					</article>`;
				})
				.join("") || `<article class="link-card empty">暂无友链</article>`;
		const feedsList = $("#feedsList");
		if (feedsList) {
			feedsList.innerHTML =
				state.feeds.map(item => `<article class="feed-item">
					<div>
						<a href="${escapeHTML(item.url || "#")}" target="_blank">${escapeHTML(item.title || "Untitled")}</a>
						<span class="feed-meta">
							${item.source ? `<span>${escapeHTML(item.source)}</span>` : ""}
							<time>${escapeHTML(dateOnly(item.date || "") || "未知")}</time>
						</span>
					</div>
				</article>`).join("") ||
				`<article class="list-item">暂无订阅文章</article>`;
		}
	}

	async function load() {
		const data = await api("list");
		Object.assign(state, data);
		renderStats();
		renderArticles();
		renderLists();
	}

	function formData(form) {
		const data = Object.fromEntries(new FormData(form).entries());
		for (const input of form.querySelectorAll("input[type='checkbox']")) data[input.name] = input.checked;
		return data;
	}

	function fillArticleForm(article) {
		const form = $("#articleForm");
		field(form, "originalPath").value = article.path || "";
		field(form, "section").value = article.section || "note";
		field(form, "locale").value = article.locale || "zh-cn";
		field(form, "title").value = article.title || "";
		field(form, "slug").value = article.slug || "";
		field(form, "series").value = article.series || "";
		field(form, "tags").value = tagList(article.tags).join(", ");
		field(form, "description").value = article.description || "";
		field(form, "toc").checked = Boolean(article.toc);
		field(form, "draft").checked = Boolean(article.draft);
		field(form, "body").value = article.body || "";
		$("#articlePreview").innerHTML = markdown(article.body || "");
	}

	function fillPrefaceForm(preface) {
		const form = $("#prefaceForm");
		field(form, "originalPath").value = preface.path || "";
		field(form, "locale").value = preface.locale || "zh-cn";
		field(form, "timestamp").value = datetimeLocal(preface.timestamp);
		field(form, "body").value = preface.body || "";
		field(form, "draft").checked = Boolean(preface.draft);
	}

	function openLinkEditor(mode = "new") {
		$(".link-add-page h3").textContent = mode === "edit" ? "编辑友链" : "添加友链";
		$("#linkForm button[type='submit']").textContent = mode === "edit" ? "保存修改" : "保存友链";
		$("#linkWorkspace").classList.add("adding");
	}

	function fillLinkForm(link) {
		const form = $("#linkForm");
		field(form, "originalUrl").value = link.url || "";
		field(form, "title").value = link.title || "";
		field(form, "url").value = link.url || "";
		field(form, "type").value = link.type || "";
		field(form, "image").value = link.image || "";
		field(form, "feed").value = link.feed || "";
		field(form, "description").value = link.description || "";
	}

	function bind() {
		$$(".tab").forEach(tab => {
			tab.addEventListener("click", () => {
				$$(".tab").forEach(node => node.classList.toggle("active", node === tab));
				$$(".panel").forEach(panel => panel.classList.toggle("active", panel.dataset.panel === tab.dataset.tab));
			});
		});

		$("[data-action='reload']").addEventListener("click", () => load().then(() => toast("已刷新")));
		$("#articleSearch").addEventListener("input", renderArticles);
		$("#sectionFilter").addEventListener("change", renderArticles);

		const articleForm = $("#articleForm");
		const articleWorkspace = $("#articleWorkspace");
		$("[data-action='newArticle']").addEventListener("click", () => {
			articleForm.reset();
			field(articleForm, "originalPath").value = "";
			field(articleForm, "locale").value = state.currentLocale;
			$("#articlePreview").innerHTML = "";
			openArticleEditor("new");
			field(articleForm, "title").focus();
			articleWorkspace.scrollIntoView({ behavior: "smooth", block: "start" });
		});
		$("[data-action='cancelArticle']").addEventListener("click", () => {
			articleWorkspace.classList.remove("editing");
		});
		field(articleForm, "title").addEventListener("input", () => {
			if (!field(articleForm, "slug").value) field(articleForm, "slug").value = slugify(field(articleForm, "title").value);
		});
		field(articleForm, "body").addEventListener("input", () => {
			$("#articlePreview").innerHTML = markdown(field(articleForm, "body").value);
		});
		$("[data-action='extract']").addEventListener("click", () => {
			const text = field(articleForm, "body").value;
			field(articleForm, "description").value = stripMarkdown(text).slice(0, 140);
			field(articleForm, "tags").value = extractTags(text).join(", ");
			$("#articlePreview").innerHTML = markdown(text);
		});
		articleForm.addEventListener("submit", async event => {
			event.preventDefault();
			const data = formData(articleForm);
			data.tags = String(data.tags || "").split(/[,，、\s]+/).filter(Boolean);
			await api("save-article", data);
			toast("文章已保存");
			await load();
			articleForm.reset();
			field(articleForm, "originalPath").value = "";
			$("#articlePreview").innerHTML = "";
			articleWorkspace.classList.remove("editing");
		});

		$("#articleRows").addEventListener("click", async event => {
			const button = event.target.closest("[data-article-action]");
			if (!button) return;
			const path = button.dataset.path;
			if (!path) return;
			const action = button.dataset.articleAction;
			if (action === "edit") {
				const data = await api("read-article", { path });
				fillArticleForm(data.article);
				openArticleEditor("edit");
				field(articleForm, "title").focus();
				articleWorkspace.scrollIntoView({ behavior: "smooth", block: "start" });
				return;
			}
			if (action === "delete") {
				if (!confirm("确定要删除这篇文章吗？这个操作会删除 Markdown 文件。")) return;
				await api("delete-article", { path });
				toast("文章已删除");
				await load();
				return;
			}
			if (action === "draft" || action === "publish") {
				await api("set-article-draft", { path, draft: action === "draft" });
				toast(action === "draft" ? "已设为草稿" : "已发布");
				await load();
			}
		});

		$("#prefaceForm").addEventListener("submit", async event => {
			event.preventDefault();
			await api("save-preface", formData(event.currentTarget));
			toast("序文已保存");
			await load();
			event.currentTarget.reset();
			field(event.currentTarget, "originalPath").value = "";
			$("#prefaceWorkspace").classList.remove("editing");
		});

		const prefaceForm = $("#prefaceForm");
		const prefaceWorkspace = $("#prefaceWorkspace");
		$("[data-action='newPreface']").addEventListener("click", () => {
			prefaceForm.reset();
			field(prefaceForm, "originalPath").value = "";
			field(prefaceForm, "locale").value = state.currentLocale;
			openPrefaceEditor("new");
			field(prefaceForm, "body").focus();
			prefaceForm.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "end" });
		});
		$("[data-action='cancelPreface']").addEventListener("click", () => {
			prefaceWorkspace.classList.remove("editing");
		});
		$("#prefaceRows").addEventListener("click", async event => {
			const button = event.target.closest("[data-preface-action]");
			if (!button) return;
			const path = button.dataset.path;
			if (!path) return;
			const action = button.dataset.prefaceAction;
			if (action === "edit") {
				const data = await api("read-preface", { path });
				fillPrefaceForm(data.preface);
				openPrefaceEditor("edit");
				field(prefaceForm, "body").focus();
				prefaceForm.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "end" });
				return;
			}
			if (action === "delete") {
				if (!confirm("确定要删除这条序文吗？这个操作会删除 Markdown 文件。")) return;
				await api("delete-preface", { path });
				toast("序文已删除");
				await load();
				return;
			}
			if (action === "draft" || action === "publish") {
				await api("set-preface-draft", { path, draft: action === "draft" });
				toast(action === "draft" ? "已设为草稿" : "已发布");
				await load();
			}
		});

		$("#memoForm").addEventListener("submit", async event => {
			event.preventDefault();
			const form = event.currentTarget;
			const button = $("[data-memo-submit]");
			const content = String(field(form, "content").value || "").trim();
			if (!content) {
				toast("请输入 Memos 内容");
				return;
			}
			const originalText = button.textContent;
			button.disabled = true;
			button.textContent = "发布中...";
			try {
				await api("publish-memo", { content, locale: state.currentLocale });
				toast("Memos 已发布");
				form.reset();
				await load();
			} catch (error) {
				toast(error.message || "发布失败");
			} finally {
				button.disabled = false;
				button.textContent = originalText;
			}
		});

		$("#discoverForm").addEventListener("submit", async event => {
			event.preventDefault();
			const data = await api("discover-site", formData(event.currentTarget));
			const form = $("#linkForm");
			field(form, "title").value = data.title || "";
			field(form, "url").value = data.url || "";
			field(form, "image").value = data.image || "";
			field(form, "feed").value = data.feed || "";
			field(form, "description").value = data.description || "";
			if (!field(form, "type").value) field(form, "type").value = "lifestyle";
			toast("已发现站点信息");
		});

		const linkWorkspace = $("#linkWorkspace");
		const discoverForm = $("#discoverForm");
		const linkForm = $("#linkForm");
		$("[data-action='addLink']").addEventListener("click", () => {
			discoverForm.reset();
			linkForm.reset();
			field(linkForm, "originalUrl").value = "";
			openLinkEditor("new");
			field(discoverForm, "url").focus();
			linkWorkspace.scrollIntoView({ behavior: "smooth", block: "start" });
		});
		$("[data-action='cancelLink']").addEventListener("click", () => {
			linkWorkspace.classList.remove("adding");
		});

		$("#linkForm").addEventListener("submit", async event => {
			event.preventDefault();
			await api("add-link", formData(event.currentTarget));
			toast("友链已保存");
			await load();
			discoverForm.reset();
			linkForm.reset();
			field(linkForm, "originalUrl").value = "";
			linkWorkspace.classList.remove("adding");
		});

		$("#linksList").addEventListener("click", async event => {
			const button = event.target.closest("[data-link-action]");
			if (!button) return;
			const url = button.dataset.url;
			if (!url) return;
			const action = button.dataset.linkAction;
			if (action === "edit") {
				const data = await api("read-link", { url });
				discoverForm.reset();
				fillLinkForm(data.item);
				openLinkEditor("edit");
				field(linkForm, "title").focus();
				linkWorkspace.scrollIntoView({ behavior: "smooth", block: "start" });
				return;
			}
			if (action === "delete") {
				if (!confirm("确定要删除这条友链吗？")) return;
				await api("delete-link", { url });
				toast("友链已删除");
				await load();
			}
		});

		$("[data-action='checkLinks']")?.addEventListener("click", async event => {
			const button = event.currentTarget;
			const originalText = button.textContent;
			button.disabled = true;
			button.textContent = "检测中...";
			toast("正在检测友链");
			try {
				const data = await api("check-links", {});
				state.links = state.links.map(link => {
					const result = data.results.find(item => item.url === link.url);
					return result ? { ...link, status: result.status } : link;
				});
				renderLists();
				toast(`检测完成：${data.results.length} 条`);
			} catch (error) {
				toast(error.message || "检测失败");
			} finally {
				button.disabled = false;
				button.textContent = originalText;
			}
		});

		$("[data-action='refreshFeeds']")?.addEventListener("click", async () => {
			const data = await api("refresh-feeds", {});
			state.feeds = data.items || [];
			state.feedSources = data.feedSources || state.feedSources;
			renderLists();
			toast("订阅源已刷新");
		});

		$$("[data-deploy]").forEach(button => {
			button.addEventListener("click", async () => {
				const form = $("#deployForm");
				$("#deployOutput").textContent = "运行中...";
				const data = await api("deploy", { mode: button.dataset.deploy, message: field(form, "message").value });
				$("#deployOutput").textContent = data.steps.map(step => `# ${step.step}\n${step.output || "OK"}`).join("\n\n");
				toast("部署动作完成");
			});
		});
	}

	bind();
	load().catch(error => toast(error.message));
</script>

